# Copy to .env (git-ignored) and fill in real values locally. Dummy values only here:
# tools/security/scan.sh forbidden rejects anything that looks like a real value.
# The project needs no secrets today; these show the expected shape.
#
# Not used by the code: only the shape of a key of our own (cxufo_live_/cxufo_test_ + 32
# characters) that the secret scanners know (tools/security, docs/SECURITY.md).
CXUFO_API_KEY=<cxufo_test_xxxxxxxx>
# (The serial port is not set here: ./start.sh --port, the settings screen or
# config/game_config.json backend.serial_port.)

# ./start.sh with no arguments: its arguments (space separated, e.g. --mock --no-gesture).
# Empty = the real robot + hand gestures + the game. CXUFO_START_MODE (game / mock / real /
# gesture / backend) is the earlier form: then CXUFO_START_ARGS go to that mode.
# Any argument to start.sh wins over these; environment variables win over .env.
CXUFO_START_ARGS=
CXUFO_START_MODE=

# Homework watch (config homework.enabled): Cloudflare Workers AI, typesafe/jev-1.14.0.
# The token needs the Workers AI permission. Environment variables win over .env.
CF_ACCOUNT_ID=<cloudflare-account-id>
CF_API_TOKEN=<cloudflare-api-token>
